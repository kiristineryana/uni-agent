# Copy this file to .env and fill in the values. Never commit .env.

# From @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID, from @userinfobot
TELEGRAM_CHAT_ID=

# API key for the provider set in config.yaml (llm.provider)
LLM_API_KEY=

# Moodle -> Calendar -> Import or export calendars -> Export calendar -> Get calendar URL
MOODLE_ICAL_URL=

# Optional, stretch: Moodle web service token (Profile -> Preferences -> Security keys)
MOODLE_TOKEN=
